register_toolchains("@rust_toolchains//:all")

# The Wren top, registered from outside Pavona.
top_desc = use_extension("@pavona_pavona//hw/top:extensions.bzl", "top")
top_desc.register(
    bazel_file = "//hw/top_wren:defs.bzl",
    top_var = "WREN",
)
