// Wren on a Digilent Genesys 2, through the FT2232H on the USB PROG port.
// Channel A: ADBUS0-3 carry SPI to spi_device, ADBUS4-5 are GPIO 29-30
// (for sampling with bit-banging), ACBUS0, ACBUS3 and ACBUS5 are the three
// software straps and ACBUS6 is the reset (data/*.xdc). Channel B is the
// board's JTAG cable, for loading the bitstream.
//
// This does not include Pavona's /__builtin__/pavona_ftdi_genesys2.json5: it
// mirrors that file's SPI and console (keep them in step with it), except that
// the console is opened by name rather than as the first FT232R. Wren's test
// setup adds a second FT232R, a PmodUSBUART on Pmod JC (uart1's pads, the
// `dut` UART of the UART tests), with the same USB strings as the board's
// own, and /dev/ttyUSBn follows enumeration order. So both are opened by
// names that a udev rule on the host gives them from their serial numbers
// (README, "Genesys 2 setup"). Nor does it include pavona.json5: Wren has no
// TAP strap pads (the chip file ties the TAP selection), no life cycle
// controller and no sysrst_ctrl, so only the reset and the software straps
// are defined.
//
// The straps are active low at the board (the chip file inverts them, so the
// FTDI's idle pull-ups do not request bootstrap), hence `invert` here.
{
  "interface": "ftdi_genesys2",
  "pins": [
    {
      "name": "RESET",
      "mode": "PushPull",
      "level": true,
      "invert": false,
      "pull_mode": "None",
      "alias_of": "acbus6"
    },
    {
      "name": "SW_STRAP0",
      "mode": "PushPull",
      "level": false,
      "invert": true,
      "pull_mode": "None",
      "alias_of": "acbus0"
    },
    {
      "name": "SW_STRAP1",
      "mode": "PushPull",
      "level": false,
      "invert": true,
      "pull_mode": "None",
      "alias_of": "acbus3"
    },
    {
      "name": "SW_STRAP2",
      "mode": "PushPull",
      "level": false,
      "invert": true,
      "pull_mode": "None",
      "alias_of": "acbus5"
    }
  ],
  "strappings": [
    {
      "name": "ROM_BOOTSTRAP",
      "pins": [
        {
          "name": "SW_STRAP0",
          "level": true
        },
        {
          "name": "SW_STRAP1",
          "level": true
        },
        {
          "name": "SW_STRAP2",
          "level": true
        }
      ]
    },
    {
      "name": "RESET",
      "pins": [
        {
          "name": "RESET",
          "level": false
        }
      ]
    }
  ],
  "spi": [
    {
      "name": "BOOTSTRAP"
    }
  ],
  "uarts": [
    {
      "name": "console",
      "baudrate": 115200,
      "parity": "None",
      "stopbits": "Stop1",
      "alias_of": "/dev/genesys2-console"
    },
    {
      "name": "dut",
      "alias_of": "/dev/genesys2-dut"
    }
  ],
  "provides": {
    "chip": "opentitan"
  }
}
